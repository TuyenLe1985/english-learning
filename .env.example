# ─── Shared (apps/api + apps/web) ────────────────────────────────────────────
# Copy this file to .env and fill in your local values.
# Never commit .env — only .env.example is tracked by git.

DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/english_learning

REDIS_URL_BULLMQ=redis://localhost:6379
REDIS_URL_CACHE=redis://localhost:6380

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=english-learning

# PostgreSQL container credentials (used by docker-compose.yml)
POSTGRES_DB=english_learning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ─── apps/web only ────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=CHANGE_ME
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ─── apps/api only ────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME
PORT=3001
