# PostgreSQL connection string — required by NextAuth/Prisma for server-side auth
DATABASE_URL=postgresql://postgres:devpassword123@localhost:5432/english_learning

# NextAuth
NEXTAUTH_SECRET=dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder

# Redis (cache layer)
REDIS_URL_CACHE=redis://localhost:6380

# MinIO public URL for client-side audio playback (local development)
# Replace with Cloudflare R2 public URL in production
NEXT_PUBLIC_MINIO_PUBLIC_URL=http://localhost:9000/english-learning

# Resend transactional email API key — required for email verification and password reset
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Email sender
EMAIL_FROM=dev@localhost
