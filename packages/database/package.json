{
  "name": "@repo/database",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "_exportNote": "Dual exports: CJS consumers (NestJS runtime) get compiled dist/index.js; bundler/ESM consumers (Next.js webpack) get TypeScript source. Node.js 22 ESM-via-require uses 'require' condition first.",
  "scripts": {
    "build": "node scripts/build-cjs.js",
    "db:generate": "prisma generate --schema ./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ./prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ./prisma/schema.prisma",
    "db:push": "prisma db push --schema ./prisma/schema.prisma",
    "db:seed": "TS_NODE_PROJECT=tsconfig.seed.json node --env-file=../../.env -r ts-node/register prisma/seed.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "prisma": {
    "seed": "TS_NODE_PROJECT=tsconfig.seed.json node --env-file=../../.env -r ts-node/register prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "vitest": "^2.0.0",
    "@repo/tsconfig": "workspace:*",
    "typescript": "^5.4.0",
    "bcryptjs": "^2.4.3",
    "@types/bcryptjs": "^2.4.6",
    "ts-node": "^10.9.2"
  }
}
