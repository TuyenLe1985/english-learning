{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "lib": ["es2022"],
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "module": "CommonJS",
    "moduleResolution": "node"
  },
  "include": ["prisma/**/*", "src/**/*"],
  "exclude": ["dist", "node_modules"]
}
